          "isMedicationCompleted",
          "isPersonalCareCompleted",
          "isFeedingTaskCompleted",
          "medicationTaskNote",
          "personalCareTaskNote",
          "feedingTaskNote"
        ],
        "type": "object",
        "properties": {
          "checkedOutAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "isMedicationCompleted": {
            "type": "boolean"
          },
          "isPersonalCareCompleted": {
            "type": "boolean"
          },
          "isFeedingTaskCompleted": {
            "type": "boolean"
          },
          "medicationTaskNote": {
            "type": "string"
          },
          "personalCareTaskNote": {
            "type": "string"
          },
          "feedingTaskNote": {
            "type": "string"
          }
        }
      },
      "CreateCareHomeRequest": {
        "required": [
          "name",
          "address",
          "email"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        }
      },
      "CreateMedicationOrderRequest": {
        "required": [
          "medicatioName",
          "route",
          "instructions",
          "startDate",
          "endDate",
          "prescriber",
          "isPrn",
          "prnIndication",
          "prnMinIntervalMinutes",
          "prnMaxDose24h",
          "isControlledDrug",
          "schedules",
          "status",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "medicatioName": {
            "type": "string"
          },
          "route": {
            "$ref": "#/components/schemas/MedicationRouteEnum"
          },
          "instructions": {
            "type": [
              "null",
              "string"
            ]
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "prescriber": {
            "type": "string"
          },
          "isPrn": {
            "type": "boolean"
          },
          "prnIndication": {
            "type": [
              "null",
              "string"
            ]
          },
          "prnMinIntervalMinutes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "prnMaxDose24h": {
            "type": [
              "null",
              "string"
            ]
          },
          "isControlledDrug": {
            "type": "boolean"
          },
          "schedules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScheduleRequest"
            }
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateStaffRequest": {
        "required": [
          "firstName",
          "lastName",
          "email",
          "phoneNumber",
          "address",
          "role",
          "password",
          "userName"
        ],
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phoneNumber": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "userName": {
            "type": "string"
          }
        }
      },
      "DayOfWeekFlags": {
        "type": "integer"
      },
      "EmailRequest": {
        "required": [
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        }
      },
      "FrequencyType": {
        "type": "integer"
      },
      "LoginRequest": {
        "required": [
          "userName",
          "password"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "LogoutRequest": {
        "required": [
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "MedicationRouteEnum": {
        "type": "integer"
      },
      "OrderStatus": {
        "type": "integer"
      },
      "RecordAdministrationRequest": {
        "required": [
          "scheduledFor",
          "outcome",
          "notes"
        ],
        "type": "object",
        "properties": {
          "scheduledFor": {
            "type": "string",
            "format": "date-time"
          },
          "outcome": {
            "type": "string"
          },
          "notes": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RefreshRequest": {
        "required": [
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "RegisterCareHomeRequest": {
        "required": [
          "careHome",
          "admin"
        ],
        "type": "object",
        "properties": {
          "careHome": {
            "$ref": "#/components/schemas/CreateCareHomeRequest"
          },
          "admin": {
            "$ref": "#/components/schemas/CareHomeAdminInput"
          }
        }
      },
      "RegisterPatientRequest": {
        "required": [
          "firstname",
          "lastname",
          "gender",
          "address",
          "dateOfBirth",
          "phoneNumber",
          "email",
          "emergencyContactName",
          "emergencyContactPhoneNumber",
          "emergencyContactRelationship"
        ],
        "type": "object",
        "properties": {
          "firstname": {
            "type": "string"
          },
          "lastname": {
            "type": "string"
          },
          "gender": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date"
          },
          "phoneNumber": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "emergencyContactName": {
            "type": "string"
          },
          "emergencyContactPhoneNumber": {
            "type": "string"
          },
          "emergencyContactRelationship": {
            "type": "string"
          }
        }
      },
      "ResetPasswordRequest": {
        "required": [
          "email",
          "token",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "ScheduleRequest": {
        "required": [
          "dose",
          "fType",
          "times",
          "intervalDays",
          "daysOfWeek",
          "anchorDate",
          "effectiveFrom",
          "effectiveTo",
          "sequence"
        ],
        "type": "object",
        "properties": {
          "dose": {
            "type": "string"
          },
          "fType": {
            "$ref": "#/components/schemas/FrequencyType"
          },
          "times": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "time"
            }
          },
          "intervalDays": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "daysOfWeek": {
            "$ref": "#/components/schemas/DayOfWeekFlags"
          },
          "anchorDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "effectiveFrom": {
            "type": "string",
            "format": "date"
          },
          "effectiveTo": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "sequence": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
